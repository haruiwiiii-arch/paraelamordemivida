
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    min-height: 100vh;
    width: 100%;
    overflow: hidden;
    background-image: url("https://i.pinimg.com/736x/84/09/c6/8409c6829a946081cf738821bef00eb9.jpg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    font-family: Arial, sans-serif;
}

.pantalla {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.dialogo {
    width: min(520px, 95vw);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
}

.retrato {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    background: linear-gradient(145deg, #ffc2e2, #e879ba);
    border: 4px solid #ffe1f1;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 5px 20px #5a234b80;
    font-size: 48px;
    color: white;
}

.ventana {
    width: 100%;
    min-height: 175px;
    background: linear-gradient(145deg, #f9a9d3, #e982bd);
    border: 3px solid #ffe0f0;
    border-radius: 16px;
    padding: 24px;
    color: #71345f;
    box-shadow: 0 8px 25px #35152f80;
    position: relative;
}

.ventana h2 {
    font-size: 21px;
    margin-bottom: 18px;
}

.ventana p {
    font-size: 17px;
    line-height: 1.7;
}

.continuar {
    position: absolute;
    bottom: 12px;
    right: 18px;
    animation: flotar 1s infinite alternate;
}

@keyframes flotar {
    from {
        transform: translateY(0);
    }
    to {
        transform: translateY(5px);
    }
}
